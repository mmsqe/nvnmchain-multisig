{
  "name": "nvnmchain-multisig",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight Safe multisig UI for NVNM Chain (Tempo-compatible L1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "verify:safe": "bun run scripts/verify-safe.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
